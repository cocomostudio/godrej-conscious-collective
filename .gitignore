
# User-specific
.gitignore.user
# ↑ For this to work, run the following **at the root of this git repository**:
# git config --local core.excludesFile .gitignore.user

# Environment
.env
.env.*
# ↑ but the scaffolded example, which carries no secrets, is the only record
#   of which keys an app needs.
!.env.example

# Build output
build/
dist/

# nodeJS / Deno / Bun / etc.
node_modules/
pnpm-lock.yaml

# Operating system
## MacOS
.DS_Store

# The website
/apps/website/.react-router/
/apps/website/test-results/
/apps/website/playwright-report/

# The CMS
/apps/cms/.tmp/
/apps/cms/.cache/
/apps/cms/.strapi/
/apps/cms/.strapi-updater.json
/apps/cms/exports/
/apps/cms/public/uploads/*
!/apps/cms/public/uploads/.gitkeep
/apps/cms/types/generated/
