# The port the Express server listens on.
HTTP_SERVER_PORT=9001

# The CMS's origin. Defaults to http://localhost:1337 in code, so it is only
# needed when the CMS is somewhere else.
# CMS_URL=http://localhost:1337

# The API token the registration relay presents to the CMS. Scoped to creating a
# Lead and nothing else, and read on the server only — it never reaches a
# browser. Must match REGISTRATION_RELAY_TOKEN in apps/cms/.env, which is what
# the seed plants.
CMS_API_TOKEN=development-registration-relay-token

# Signs the registration form token. A development literal; production supplies
# its own, and rotating it invalidates every form token already handed out —
# which costs a visitor mid-form one retry and nothing else.
REGISTRATION_TOKEN_SECRET=development-registration-token-secret
