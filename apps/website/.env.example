
# Development values. These carry no secrets and are safe in version control —
# they exist so that a fresh clone boots with one command. Production supplies
# its own.
#
#
# `scripts/ensure-local-env.js` copies this to `apps/website/.env` on a fresh
# clone and never overwrites an existing one.
#
# **Which file is read is decided in package.json**, not by a variable:
# `dev` reads `.env`, `start` reads `.env.production`. Both use
# `--env-file-if-exists`, so a missing file is not an error — the server boots
# on defaults with no secrets and no CMS token, and says nothing. If production
# looks like it is running on nobody's configuration, check the file exists
# before checking anything else.
#
# Node lets the real environment win over the file, so anything PM2 sets in its
# `env_production` block overrides what is written here. That is why the port
# lives in this file and not in the ecosystem config.
#
# Generating a value for anything below marked "random":
#
#     openssl rand -base64 32


# ─── Server ───────────────────────────────────────────────────────────────────

# The interface the Express server binds to.
#
# Empty means 127.0.0.1: only this machine can reach it. Set 0.0.0.0 to let a
# phone on the same network in, or name one address — a tailnet IP, say — on a
# machine that also has a public interface. Production leaves it empty; nginx
# proxies to loopback on the same host.
HTTP_SERVER_HOST=

# The port the Express server listens on. Anything unparseable falls back to
# 9001 rather than failing.
#
# In production this must equal WEBSITE_PORT in
# infra/production/website-host/.env, which is what nginx proxies to. Nothing
# reconciles the two.
HTTP_SERVER_PORT=9001

# Express's `trust proxy` setting, and **false unless a deployment says
# otherwise.**
#
# It decides one thing that matters: whether `req.ip` is the socket's address or
# the client hop named in `X-Forwarded-For`. That header is trivially forged by
# anything that is not a browser, so trusting it unconditionally would hand
# every rate-limited caller an unlimited supply of identities — a rate limiter
# that does not limit. Not trusting it when there *is* a proxy is the mirror
# failure: `req.ip` is then the proxy on every request, so every caller shares
# one bucket.
#
# It is therefore a fact about the deployment, not a preference. Empty, "false"
# and unset all mean no proxy, which is right in development. Production is
# behind nginx behind an ALB and sets **2** — each hop appends to the header, so
# the app sees `<client>, <alb>` and has to be told how many to discount. Change
# the number of proxies and this changes with it.
#
# Values are Express's own: a hop count, "true" for all of them, "loopback", or
# a CIDR range. Applied to both Express instances — the outer server and the
# inner one route handlers run on.
TRUST_PROXY=


# ─── The CMS ──────────────────────────────────────────────────────────────────

# The CMS's origin **as this server reaches it**. Only this process ever dials
# it, so it is free to be an address only this process can resolve — a loopback
# port, a private host, an internal DNS name.
#
# Defaults to http://localhost:1337, which is right in development where both
# apps are on one machine. In they are on separate machines, this
# must be set or every page fails on a connection error.
# CMS_URL=http://localhost:1337

# The name the CMS answers to, when CMS_URL is an address rather than a name.
# Sent as the Host header, which is what routes the request to Strapi rather
# than to another application on the same machine. Leave unset where the CMS
# is the only thing listening.
CMS_HOST_NAME=

# The CMS's origin **as a browser reaches it**, which is a different question
# and frequently a different answer: CMS_URL may be an address no visitor can
# resolve. This one goes in front of every relative `/uploads/…` path the CMS
# hands back, and ends up in an `src` attribute in someone else's browser.
#
# Three distinct settings, and the difference between the last two is real:
#
#   absent          falls back to CMS_URL — right in development, where the two
#                   are the same machine
#   present, empty  uploads are addressed relative to the website's own origin.
#                   Only correct if the reverse proxy forwards /uploads/ to the
#                   CMS, which the production config does NOT do
#   set             that origin is used verbatim
#
# In production this matters less than it looks: the S3 upload provider returns
# absolute CDN URLs, and `media_url()` passes absolute URLs through untouched.
# This is the fallback for any upload still carrying a relative path from before
# S3 — so it should be the CMS's public origin, and must not be empty.
CMS_PUBLIC_URL=

# The API token the registration relay presents to the CMS. Scoped to creating a
# Lead and nothing else, and read on the server only — it never reaches a
# browser. Must match REGISTRATION_RELAY_TOKEN in the CMS's env file, which is
# what the seed plants.
#
# **No default.** A fallback here would be a credential somebody could ship
# without meaning to. Missing, the relay refuses the submission and says why in
# the log; the rest of the site is untouched.
CMS_API_TOKEN=development-registration-relay-token


# ─── Signing secrets ──────────────────────────────────────────────────────────

# Random. Signs the registration form token. No default, for the same reason as
# the API token.
#
# Rotating it invalidates every token already handed out, which costs a visitor
# mid-form one retry — the overlay mints a fresh token each time it opens.
REGISTRATION_TOKEN_SECRET=development-registration-token-secret

# Random. Signs the Add to Calendar links. No default, same reason again.
#
# This one is **visible when missing**, unlike the other two. The endpoint
# behind those links honours only what it signed, so without a secret there are
# no links to mint and the button is not drawn at all — deliberate, because a
# button that 404s on press is worse than one that is not there, but it does
# mean forgetting this loses a feature rather than degrading quietly.
#
# Rotating it invalidates every link in an already-rendered page. The cost is
# one refresh.
CALENDAR_LINK_SECRET=development-calendar-link-secret


# ─── Build output ─────────────────────────────────────────────────────────────

# Where `react-router build` put its two halves, relative to apps/website.
# Defaults are correct unless the build output has been moved.
# SERVER_BUILD_DIR=./build/server
# CLIENT_BUILD_DIR=./build/client


# ─── Set elsewhere, not here ──────────────────────────────────────────────────
#
# NODE_ENV   Set by the package.json script itself — "development" for `dev`,
#            "production" for `start` — and again by PM2.
# APP_ENV    What the application actually reads, falling back to NODE_ENV.
#            **Only the exact string "production" counts as production.** A
#            typo does not fail; it silently reads as development.
#
# See infra/production/website-host/pm2/ecosystem.config.cjs.
