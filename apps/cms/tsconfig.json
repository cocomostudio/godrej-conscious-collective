{
	"extends": "@strapi/typescript-utils/tsconfigs/server",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "."
	},
	"include": [
		"./",
		"./**/*.ts",
		"./**/*.js",
		"./**/*.json"
	],
	"exclude": [
		"node_modules/",
		"build/",
		"dist/",
		".cache/",
		".tmp/",
		"src/admin/",
		"tests/",
		"**/*.test.ts",
		"vitest.config.ts",
		"src/plugins/**",
		"scripts/"
	]
}
