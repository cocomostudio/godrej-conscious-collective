{
	"name": "app.cms",
	"version": "0.0.1",
	"private": true,
	"description": "The Strapi CMS behind the Godrej Conscious Collective website.",
	"license": "ISC",
	"scripts": {
		"build": "pnpm run build:plugins && strapi build",
		"build:plugins": "pnpm --filter strapi-plugin-export-entries run build",
		"console": "strapi console",
		"dev": "pnpm run build:plugins && strapi develop",
		"develop": "pnpm run dev",
		"seed": "node scripts/seed/index.ts",
		"start": "strapi start",
		"strapi": "strapi",
		"test": "pnpm run build:plugins && vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"strapi": {
		"telemetryDisabled": true
	},
	"dependencies": {
		"@strapi/plugin-color-picker": "5.52.1",
		"@strapi/plugin-users-permissions": "5.52.1",
		"@strapi/provider-upload-aws-s3": "5.52.1",
		"@strapi/strapi": "5.52.1",
		"@strapi/utils": "5.52.1",
		"better-sqlite3": "13.0.3",
		"pg": "8.23.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-router-dom": "6.30.3",
		"strapi-plugin-export-entries": "workspace:*",
		"strapi-plugin-webtools": "1.10.3",
		"styled-components": "6.1.19",
		"webtools-addon-sitemap": "1.3.1"
	},
	"devDependencies": {
		"@strapi/typescript-utils": "5.52.1",
		"@types/mdast": "4.0.4",
		"@types/node": "22.20.1",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"mdast-util-from-markdown": "2.0.3",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
