{
	"collectionName": "components_container_section_v1",
	"info": {
		"displayName": "Section",
		"description": "A standalone section of a page. Everything an editor places in a main region is a section."
	},
	"options": {},
	"attributes": {
		"title": {
			"type": "string",
			"required": true
		},
		"register_with_toc": {
			"type": "boolean",
			"default": false,
			"required": true
		},
		"heading": {
			"type": "component",
			"component": "text.heading-v1",
			"required": false
		},
		"opening_line": {
			"type": "component",
			"component": "text.plain-string-v1",
			"required": false
		},
		"link": {
			"type": "component",
			"component": "navigation.link-v1",
			"required": false
		},
		"background_gradient": {
			"type": "enumeration",
			"enum": [
				"none",
				"light",
				"white-to-light",
				"showcase",
				"showcase-to-light",
				"light-to-showcase",
				"conversation",
				"conversation-to-light",
				"light-to-conversation",
				"experience",
				"experience-to-light",
				"light-to-experience",
				"workshop",
				"workshop-to-light",
				"light-to-workshop",
				"collaborator",
				"collaborator-to-light",
				"light-to-collaborator",
				"theme",
				"theme-to-light",
				"light-to-theme",
				"context",
				"light-to-context",
				"context-to-light"
			],
			"default": "none",
			"required": true
		},
		"background_pattern": {
			"type": "enumeration",
			"enum": [
				"none",
				"spider-web-1",
				"spider-web-2",
				"spider-web-3"
			],
			"default": "none",
			"required": true
		},
		"background_position": {
			"type": "enumeration",
			"enum": [
				"left",
				"right",
				"top-left",
				"top-right",
				"bottom-left",
				"bottom-right",
				"center"
			],
			"default": "left",
			"required": true
		},
		"horizontal_rule": {
			"type": "boolean",
			"default": false,
			"required": true
		},
		"spacing_around": {
			"type": "enumeration",
			"enum": [
				"normal",
				"none",
				"above",
				"below"
			],
			"default": "normal",
			"required": true
		},
		"content": {
			"type": "dynamiczone",
			"components": [
				"text.heading-v1",
				"text.plain-string-v1",
				"text.wysiwyg-v1",
				"text.quote-v1",
				"text.marquee-v1",
				"navigation.link-v1",
				"navigation.image-link-v1",
				"media.image-v1",
				"media.responsive-image-v1",
				"media.full-bleed-image-v1",
				"media.gallery-v1",
				"media.google-map-v1",
				"media.vanilla-carousel-v1",
				"media.instagram-feed-v1",
				"list.sponsors-list-v1",
				"list.archive-carousel-listing-v1",
				"list.archive-timeline-listing-v1",
				"list.profile-list-v1",
				"list.session-list-v1",
				"list.session-listing-v1",
				"list.session-listing-with-filtration-v1",
				"list.session-schedule-list-v1",
				"list.contributor-listing-v1",
				"miscellaneous.horizontal-rule-v1",
				"container.image-and-content-v1",
				"container.image-stack-and-content-v1",
				"container.map-and-content-v1"
			]
		}
	},

	"__": {
		"note": "Admin metadata for this schema. Strapi ignores this key; src/this/admin-metadata reads it and writes it into the content manager's stored configuration on every boot.",
		"metadatas": {
			"title": {
				"edit": {
					"label": "Title",
					"description": "How this section is named in the table of contents. It is not shown in the section itself — the heading below is."
				},
				"list": {
					"label": "Title"
				}
			},
			"register_with_toc": {
				"edit": {
					"label": "Show in the table of contents?",
					"description": "Lists this section in the table of contents, where the page has one."
				},
				"list": {
					"label": "Show in the table of contents?"
				}
			},
			"heading": {
				"edit": {
					"label": "Heading",
					"description": "Shown at the top of the section. Leave it empty and the opening line below is not shown either — it has nothing to open."
				},
				"list": {
					"label": "Heading"
				}
			},
			"opening_line": {
				"edit": {
					"label": "Opening line",
					"description": "A line beneath the heading. It is not shown at all when there is no heading above it. It is a plain string rather than a bare line of text, so that it answers for its own colour like every other run of words in the catalogue."
				},
				"list": {
					"label": "Opening line"
				}
			},
			"link": {
				"edit": {
					"label": "Link",
					"description": "A link beside the heading. Where the heading carries a link of its own, the heading's is the one shown."
				},
				"list": {
					"label": "Link"
				}
			},
			"background_gradient": {
				"edit": {
					"label": "Background",
					"description": "A colour fading down into grey, or a flat grey, or nothing."
				},
				"list": {
					"label": "Background"
				}
			},
			"background_pattern": {
				"edit": {
					"label": "Background pattern",
					"description": "A drawing laid over the background."
				},
				"list": {
					"label": "Background pattern"
				}
			},
			"background_position": {
				"edit": {
					"label": "Background pattern position",
					"description": "Where the pattern sits. It has no effect where there is no pattern."
				},
				"list": {
					"label": "Background pattern position"
				}
			},
			"horizontal_rule": {
				"edit": {
					"label": "Horizontal Rule below",
					"description": "Draws a line below this section, separating it from the one after."
				},
				"list": {
					"label": "Horizontal Rule below"
				}
			},
			"spacing_around": {
				"edit": {
					"label": "Spacing around",
					"description": "The padding this section lays down above and below itself. \"normal\" lays it down on both sides, \"above\" and \"below\" on one side only, \"none\" on neither. A block sitting at the section’s edge can decline it too — the space goes if either of them says so."
				},
				"list": {
					"label": "Spacing around"
				}
			},
			"content": {
				"edit": {
					"label": "Content",
					"description": "What the section holds."
				},
				"list": {
					"label": "Content"
				}
			}
		},
