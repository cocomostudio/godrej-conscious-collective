				],
				[
					{ "name": "opening_line", "size": 12 }
				],
				[
					{ "name": "link", "size": 12 }
				],
				[
					{ "name": "background_gradient", "size": 4 },
					{ "name": "background_pattern", "size": 4 },
					{ "name": "background_position", "size": 4 }
				],
				[
					{ "name": "horizontal_rule", "size": 4 },
					{ "name": "spacing_around", "size": 4 }
				],
				[
					{ "name": "content", "size": 12 }
				]
			]
		}
	}
}
