{
	"collectionName": "components_code_script_v1",
	"info": {
		"displayName": "Script",
		"description": "One <script> tag, injected into the document."
	},
	"options": {},
	"attributes": {
		"type": {
			"type": "enumeration",
			"enum": [
				"text/javascript",
				"module",
				"importmap"
			],
			"default": "text/javascript",
			"required": true
		},
		"src": {
			"type": "string",
			"required": false
		},
		"code": {
			"type": "text",
			"required": false
		},
		"async": {
			"type": "boolean",
			"default": false,
			"required": false
		},
		"defer": {
			"type": "boolean",
			"default": false,
			"required": false
		},
		"cross_origin": {
			"type": "enumeration",
			"enum": [
				"anonymous",
				"use-credentials"
			],
			"default": "anonymous",
			"required": true
		},
		"integrity": {
			"type": "string",
			"required": false
		},
		"nonce": {
			"type": "string",
			"required": false
		},
		"referrer_policy": {
			"type": "enumeration",
			"enum": [
				"no-referrer",
				"no-referrer-when-downgrade",
				"origin",
				"origin-when-cross-origin",
				"same-origin",
				"strict-origin",
				"strict-origin-when-cross-origin",
				"unsafe-url"
			],
			"default": "strict-origin-when-cross-origin",
			"required": true
		}
	},

