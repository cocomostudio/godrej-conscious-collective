{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"types": ["node"]
	},
	"include": [
		"./scripts/**/*.ts",
		"./tests/**/*.ts",
		"./vitest.config.ts"
	],
	"exclude": [
		"node_modules/"
	]
}
