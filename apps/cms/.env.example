# Development values. These carry no secrets and are safe in version control —
# they exist so that a fresh clone boots with one command. Production supplies
# its own.

HOST=0.0.0.0
PORT=1337

APP_KEYS=development-key-one,development-key-two
API_TOKEN_SALT=development-api-token-salt
ADMIN_JWT_SECRET=development-admin-jwt-secret
TRANSFER_TOKEN_SALT=development-transfer-token-salt
ENCRYPTION_KEY=development-encryption-key-0000000000000000
JWT_SECRET=development-users-permissions-jwt-secret

# "sqlite" (development) or "postgres" (production). Anything else throws.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Whether the admin panel shows the fields that exist for the seed script rather
# than for an editor — today that is the `url` beside the file picker on an
# Image. "true" or "false"; anything else refuses the boot. Left empty, the
# environment decides, which shows them anywhere NODE_ENV is not "production".
# Set it to override that on one server without moving NODE_ENV, which would
# move a great deal more than one field.
ADMIN_SHOW_DEVELOPER_FIELDS=

# Where the website is served from. Webtools uses it to build absolute URLs, and
# the admin's Entry Preview uses it to build the preview URL.
WEBSITE_URL=http://localhost:9001
WEBSITE_URLS=http://localhost:9001

# Postgres — production only.
# DATABASE_URL=
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# DATABASE_SSL=false
# DATABASE_SCHEMA=public

# The S3 upload provider — production only.
# AWS_REGION=
# AWS_BUCKET_NAME=
# CDN_URL=

# The API token the website's registration relay carries. A development literal,
# like the keys and salts above: the seed plants a token with exactly this value
# so that a fresh clone has a working registration form, and the seed refuses to
# run anywhere but local SQLite. Production mints its own in the admin panel and
# never carries it here.
REGISTRATION_RELAY_TOKEN=development-registration-relay-token

# Production only. Strapi's Transfer feature pulls the whole database behind one
# token, registrations included, bypassing every layer that protects the Lead
# route — so the receiver is off unless somebody is actively using it.
# TRANSFER_REMOTE_ENABLED=false
