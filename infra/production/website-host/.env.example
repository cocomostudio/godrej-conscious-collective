#
# The website host — the deployment facts for this one machine.
#
# Copy to `.env` beside this file and fill in. `.env` is gitignored; this
# example is the only record of which keys the host needs.
#
# Read by infra/install.js when it generates the nginx fragments, and by
# infra/production/website-host/pm2/ecosystem.config.cjs when PM2 starts the
# app.
#
# This file does NOT configure the website. The application reads
# apps/website/.env.production — note the name; the `start` script passes
# `--env-file-if-exists .env.production`, not `.env`.
#

# The host name this machine answers to. One name, no scheme, no trailing dot.
WEBSITE_SERVER_NAME=www.example.com

# The port the Express server listens on, and therefore the port nginx proxies
# to.
#
# This has to match HTTP_SERVER_PORT in apps/website/.env.production on this
# machine. Nothing reconciles the two for you.
WEBSITE_PORT=9001

# The CMS's public origin, with scheme, no trailing slash.
#
# Used for one thing here: the `frame-ancestors` in this site's
# Content-Security-Policy. Entry Preview renders this site inside an iframe in
# the CMS admin, so the CMS origin has to be allowed to frame it or preview
# shows an empty box. It is the mirror of the `frame-src` that
# apps/cms/config/middlewares.ts builds from WEBSITE_URLS — both sides have to
# name the other.
CMS_ORIGIN=https://cms.example.com

# Where PM2 writes the process logs. Absolute paths — see the note in the CMS
# host's example.
WEBSITE_ERROR_LOG=/var/log/gcc/website.pm2.error.log
WEBSITE_OUT_LOG=/var/log/gcc/website.pm2.out.log
