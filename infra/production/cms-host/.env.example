#
# The CMS host — the deployment facts for this one machine.
#
# Copy to `.env` beside this file and fill in. `.env` is gitignored; this
# example is the only record of which keys the host needs, which is the same
# arrangement the apps use.
#
# Read by infra/install.js when it generates the nginx fragments, and by
# infra/production/cms-host/pm2/ecosystem.config.cjs when PM2 starts the app.
#
# This file does NOT configure Strapi. The application reads apps/cms/.env, and
# the two must agree about the port — see the note on CMS_PORT.
#

# The host name this machine answers to. One name, no scheme, no trailing dot.
# Written into the server block as `server_name`.
CMS_SERVER_NAME=cms.example.com

# The port Strapi listens on, and therefore the port nginx proxies to.
#
# This has to match PORT in apps/cms/.env on this machine. Strapi reads PORT —
# see apps/cms/config/server.ts — and nothing reconciles the two for you: set
# them apart and nginx proxies to a closed port, which is a 502 on every
# request.
CMS_PORT=1337

# Where PM2 writes the process logs. Absolute paths: PM2 resolves a relative one
# against the app's cwd, which is the checkout, and logs do not belong there.
CMS_ERROR_LOG=/var/log/gcc/cms.pm2.error.log
CMS_OUT_LOG=/var/log/gcc/cms.pm2.out.log
